{
  "datasets": [
    {
      "name": "da258172",
      "displayName": "Multi-Language Project Activity - Top 20 Languages",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    p.`language_name`,\n",
        "    COUNT(DISTINCT p.`project_key`) as project_count,\n",
        "    COUNT(*) as total_edits,\n",
        "    COUNT(DISTINCT f.`user`) as active_editors,\n",
        "    COUNT(DISTINCT f.`title`) as pages_edited,\n",
        "    SUM(f.`byte_change`) as net_content_change,\n",
        "    AVG(f.`abs_byte_change`) as avg_edit_size\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p ON f.`project_key` = p.`project_key`\n",
        "WHERE p.`language_name` IS NOT NULL\n",
        "  AND p.`language_code` NOT IN ('commons', 'wikidata')\n",
        "GROUP BY p.`language_name`\n",
        "ORDER BY total_edits DESC\n",
        "LIMIT 20\n"
      ]
    },
    {
      "name": "75115709",
      "displayName": "Hourly Activity Patterns - Edit Volume by Hour",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    HOUR(`event_time`) as hour_of_day,\n",
        "    COUNT(*) as edit_count,\n",
        "    AVG(`abs_byte_change`) as avg_edit_size,\n",
        "    COUNT(DISTINCT `user`) as active_users,\n",
        "    SUM(CASE WHEN `byte_change` > 0 THEN 1 ELSE 0 END) as additions,\n",
        "    SUM(CASE WHEN `byte_change` < 0 THEN 1 ELSE 0 END) as deletions\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "GROUP BY HOUR(`event_time`)\n",
        "ORDER BY hour_of_day\n"
      ]
    },
    {
      "name": "5191e110",
      "displayName": "Hourly Activity Patterns - Edits vs Active Users",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    HOUR(`event_time`) as hour_of_day,\n",
        "    COUNT(*) as edit_count,\n",
        "    COUNT(DISTINCT `user`) as active_users\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "GROUP BY HOUR(`event_time`)\n",
        "ORDER BY hour_of_day\n"
      ]
    },
    {
      "name": "544be9a0",
      "displayName": "Project Diversity & Coverage - Key Metrics",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    'Total Edits' as metric,\n",
        "    COUNT(*) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Unique Editors' as metric,\n",
        "    COUNT(DISTINCT `user`) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Pages Edited' as metric,\n",
        "    COUNT(DISTINCT `title`) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Active Projects' as metric,\n",
        "    COUNT(DISTINCT `project_key`) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Net Bytes Added (MB)' as metric,\n",
        "    CAST(SUM(`byte_change`) / 1048576.0 AS BIGINT) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n",
        "UNION ALL\n",
        "SELECT \n",
        "    'Avg Edit Size (bytes)' as metric,\n",
        "    CAST(AVG(`abs_byte_change`) AS BIGINT) as value\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits`\n"
      ]
    },
    {
      "name": "c0c99c3f",
      "displayName": "Bot vs Human Editor Performance Comparison",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    et.`editor_type_desc`,\n",
        "    COUNT(*) as edit_count,\n",
        "    COUNT(DISTINCT f.`user`) as unique_editors,\n",
        "    AVG(f.`abs_byte_change`) as avg_edit_size,\n",
        "    SUM(CASE WHEN f.`is_minor_edit` = true THEN 1 ELSE 0 END) as minor_edits,\n",
        "    SUM(CASE WHEN f.`byte_change` > 0 THEN 1 ELSE 0 END) as additions,\n",
        "    SUM(CASE WHEN f.`byte_change` < 0 THEN 1 ELSE 0 END) as deletions,\n",
        "    SUM(f.`byte_change`) as net_bytes_added,\n",
        "    COUNT(DISTINCT f.`title`) as pages_edited\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_editor_type` et ON f.`editor_type_key` = et.`editor_type_key`\n",
        "GROUP BY et.`editor_type_desc`\n"
      ]
    },
    {
      "name": "89424d1b",
      "displayName": "Bot vs Human Detailed Breakdown by Language",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    p.`language_name`,\n",
        "    SUM(CASE WHEN et.`editor_type_desc` = 'Bot' THEN 1 ELSE 0 END) as bot_edits,\n",
        "    SUM(CASE WHEN et.`editor_type_desc` = 'Human' THEN 1 ELSE 0 END) as human_edits,\n",
        "    COUNT(DISTINCT CASE WHEN et.`editor_type_desc` = 'Bot' THEN f.`user` END) as bot_editors,\n",
        "    COUNT(DISTINCT CASE WHEN et.`editor_type_desc` = 'Human' THEN f.`user` END) as human_editors,\n",
        "    ROUND(AVG(CASE WHEN et.`editor_type_desc` = 'Bot' THEN f.`abs_byte_change` END), 0) as bot_avg_edit_size,\n",
        "    ROUND(AVG(CASE WHEN et.`editor_type_desc` = 'Human' THEN f.`abs_byte_change` END), 0) as human_avg_edit_size,\n",
        "    ROUND(100.0 * SUM(CASE WHEN et.`editor_type_desc` = 'Bot' THEN 1 ELSE 0 END) / COUNT(*), 1) as bot_percentage\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p ON f.`project_key` = p.`project_key`\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_editor_type` et ON f.`editor_type_key` = et.`editor_type_key`\n",
        "WHERE p.`language_name` IS NOT NULL\n",
        "  AND p.`language_code` NOT IN ('commons', 'wikidata')\n",
        "GROUP BY p.`language_name`\n",
        "ORDER BY (bot_edits + human_edits) DESC\n",
        "LIMIT 12\n"
      ]
    },
    {
      "name": "aa984518",
      "displayName": "Editor Productivity: Edits per Editor by Language & Type",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    p.`language_name`,\n",
        "    et.`editor_type_desc`,\n",
        "    COUNT(DISTINCT f.`user`) as unique_editors,\n",
        "    COUNT(*) as edit_count,\n",
        "    CAST(COUNT(*) * 1.0 / COUNT(DISTINCT f.`user`) AS DECIMAL(10,1)) as edits_per_editor\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p ON f.`project_key` = p.`project_key`\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_editor_type` et ON f.`editor_type_key` = et.`editor_type_key`\n",
        "WHERE p.`language_name` IS NOT NULL\n",
        "  AND p.`language_code` NOT IN ('commons', 'wikidata')\n",
        "  AND p.`language_name` IN ('English', 'French', 'German', 'Spanish', 'Russian', 'Italian', 'Chinese', 'Japanese', 'Arabic', 'Portuguese')\n",
        "GROUP BY p.`language_name`, et.`editor_type_desc`\n",
        "ORDER BY p.`language_name`, et.`editor_type_desc`\n"
      ]
    },
    {
      "name": "f0f69a8c",
      "displayName": "Bot vs Human Edit Distribution - Stacked 100% View",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    p.`language_name`,\n",
        "    SUM(CASE WHEN et.`editor_type_desc` = 'Bot' THEN 1 ELSE 0 END) as bot_edits,\n",
        "    SUM(CASE WHEN et.`editor_type_desc` = 'Human' THEN 1 ELSE 0 END) as human_edits,\n",
        "    COUNT(*) as total_edits,\n",
        "    ROUND(100.0 * SUM(CASE WHEN et.`editor_type_desc` = 'Bot' THEN 1 ELSE 0 END) / COUNT(*), 1) as bot_percentage,\n",
        "    ROUND(100.0 * SUM(CASE WHEN et.`editor_type_desc` = 'Human' THEN 1 ELSE 0 END) / COUNT(*), 1) as human_percentage\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p ON f.`project_key` = p.`project_key`\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_editor_type` et ON f.`editor_type_key` = et.`editor_type_key`\n",
        "WHERE p.`language_name` IS NOT NULL\n",
        "  AND p.`language_code` NOT IN ('commons', 'wikidata')\n",
        "GROUP BY p.`language_name`\n",
        "ORDER BY total_edits DESC\n",
        "LIMIT 15\n"
      ]
    },
    {
      "name": "793390c8",
      "displayName": "Bot vs Human Edits - Side-by-Side Comparison",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    p.`language_name`,\n",
        "    et.`editor_type_desc`,\n",
        "    COUNT(*) as edit_count\n",
        "FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p ON f.`project_key` = p.`project_key`\n",
        "JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_editor_type` et ON f.`editor_type_key` = et.`editor_type_key`\n",
        "WHERE p.`language_name` IS NOT NULL\n",
        "  AND p.`language_code` NOT IN ('commons', 'wikidata')\n",
        "  AND p.`language_name` IN (\n",
        "    SELECT p2.`language_name`\n",
        "    FROM `dbr_dev`.`wikimedia_prod_gold`.`fact_wikipedia_edits` f2\n",
        "    JOIN `dbr_dev`.`wikimedia_prod_gold`.`dim_project` p2 ON f2.`project_key` = p2.`project_key`\n",
        "    WHERE p2.`language_name` IS NOT NULL\n",
        "  AND p2.`language_code` NOT IN ('commons', 'wikidata')\n",
        "    GROUP BY p2.`language_name`\n",
        "    ORDER BY COUNT(*) DESC\n",
        "    LIMIT 15\n",
        "  )\n",
        "GROUP BY p.`language_name`, et.`editor_type_desc`\n",
        "ORDER BY p.`language_name`, et.`editor_type_desc`\n"
      ]
    }
  ],
